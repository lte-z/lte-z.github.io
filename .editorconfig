root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = false
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# Preserve third-party file endings.
[{public/assets/brand/*.svg,public/assets/fonts/sarasa-sc/LICENSE.txt}]
insert_final_newline = unset