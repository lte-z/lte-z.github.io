---
import type { Project } from '../lib/content';
interface Props { project: Project }
const { project: { data: project } } = Astro.props;
const colors: Record<string, string> = { Rust: '#dea584', TypeScript: '#3178c6', JavaScript: '#f1e05a', Python: '#3572a5', 'C++': '#f34b7d', 'C#': '#178600', Go: '#00add8', CSS: '#663399' };
const repositories = [
  ...project.gitee.map(link => ({ ...link, platform: 'gitee', name: 'Gitee' })),
  ...project.github.map(link => ({ ...link, platform: 'github', name: 'GitHub' }))
];
const hasLinks = Boolean(repositories.length || project.sourceStatus || project.links.length);
const hasMetadata = Boolean(project.languages.length || hasLinks);
---
<article class:list={['project-card', `project-card--${project.tone}`]}>
  <div class="project-head">
    <div class:list={['project-logo', { 'project-logo--full': project.logoLayout === 'full' }]}>
      {project.logo ? <img class="project-mark" src={project.logo} alt="" width="36" height="36" loading="lazy" decoding="async" /> : <svg class="project-mark" viewBox="0 0 48 48" fill="none" aria-hidden="true"><path d="M17 16L9 24l8 8M31 16l8 8-8 8M28 12l-8 24" stroke="currentColor" stroke-width="2.55" stroke-linecap="round" stroke-linejoin="round" /></svg>}
    </div>
    <div class="project-writing"><h2>{project.title}</h2><p>{project.description}</p></div>
  </div>
  {hasMetadata && <div class="project-foot">
    {project.languages.length > 0 && <div class="project-languages">{project.languages.map(language => <span class="project-language"><i aria-hidden="true" style={`--lang-color:${colors[language] ?? 'var(--muted)'}`}></i>{language}</span>)}</div>}
    {hasLinks && <div class="project-links">
      {repositories.map(link => <a class="project-outlink" href={link.url} target="_blank" rel="noopener noreferrer" aria-label={`${project.title} — ${link.name}${link.label === link.name ? '' : ` — ${link.label}`}`}><span class={`brand-symbol brand-symbol--${link.platform}`} aria-hidden="true"></span><span>{link.label}</span></a>)}
      {project.sourceStatus && <span class="project-source-closed">{project.sourceStatus === 'private' ? 'Private' : 'Source unavailable'}</span>}
      {project.links.map(link => <a class="project-outlink" href={link.url} target="_blank" rel="noopener noreferrer" aria-label={`${project.title} — ${link.label}`}><svg class="project-link-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M10 13.5a5 5 0 0 0 7.8.6l2.3-2.3a5 5 0 0 0-7.1-7.1l-1.3 1.3M14 10.5a5 5 0 0 0-7.8-.6l-2.3 2.3A5 5 0 0 0 11 19.3l1.3-1.3" /></svg><span>{link.label}</span></a>)}
    </div>}
  </div>}
</article>